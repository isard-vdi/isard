#!/bin/sh
# Exit the container when haproxy is up but no longer serving, so the restart
# policy can act. Docker's restart policy only reacts to the main process
# exiting, and a failing healthcheck moves nothing on its own -- a master that
# wedges after its worker dies leaves the container Up and answering nothing.

: "${WATCHDOG_START_PERIOD:=90}"
: "${WATCHDOG_INTERVAL:=30}"
: "${WATCHDOG_FAILURES:=3}"
: "${WATCHDOG_GRACE:=10}"

# Signalling PID 1 does not end the container: it is tini, which forwards the
# signal to haproxy instead of exiting, and haproxy reads SIGTERM as a soft-stop
# that a wedged master may never finish. Ending tini's own child is what makes
# tini exit and the container with it.
stop_serving() {
    master=$(ps -o pid=,ppid=,args= 2>/dev/null \
        | awk '$2 == 1 && $3 ~ /haproxy/ { print $1; exit }')
    if [ -z "$master" ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] watchdog: no haproxy child of PID 1 to stop"
        return
    fi
    kill -TERM "$master" 2>/dev/null
    i=0
    while [ "$i" -lt "$WATCHDOG_GRACE" ]; do
        kill -0 "$master" 2>/dev/null || return
        sleep 1
        i=$((i + 1))
    done
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] watchdog: haproxy $master did not stop in ${WATCHDOG_GRACE}s, killing"
    kill -KILL "$master" 2>/dev/null
}

sleep "$WATCHDOG_START_PERIOD"

failures=0
while true; do
    if haproxy-healthy; then
        failures=0
    else
        failures=$((failures + 1))
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] watchdog: admin socket reports no worker ($failures/$WATCHDOG_FAILURES)"
        if [ "$failures" -ge "$WATCHDOG_FAILURES" ]; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] watchdog: stopping haproxy so the container is restarted"
            stop_serving
            exit 0
        fi
    fi
    sleep "$WATCHDOG_INTERVAL"
done
