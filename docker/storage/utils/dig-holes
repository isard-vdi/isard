"""Give back the zeros of stopped desktops' disks, without changing a byte.

Dry run by default: lists the eligible disks and what each would give back.

    dig-holes                                  # report only
    dig-holes --apply --limit 1 --min-reclaim 1G --report /isard/dig-holes.jsonl
    dig-holes --apply --ids <storage-id> ...   # just these

Run it from isard-storage, where the files are visible:

    docker exec -it isard-storage dig-holes ...

--apply asks the product to dig each disk (PUT /item/storage/{id}/dig-holes)
and waits for its task; the disk is parked while it is dug. The product only
digs a stopped desktop's own leaf disk and says why it refuses any other. It
hashes the file before and after; a disk that reads differently is left
damaged and the run stops.
See storage_lib/holes.py for why a disk is or is not eligible.
"""

import argparse
import json
import os
import sys
import time

from storage_lib import api
from storage_lib.holes import DEFAULT_SETTLE_SECONDS, as_report_row, classify, measure

TERMINAL = ("finished", "failed", "canceled")


def size(text):
    units = {"k": 1 << 10, "m": 1 << 20, "g": 1 << 30, "t": 1 << 40}
    text = str(text).strip().lower()
    return (
        int(float(text[:-1]) * units[text[-1]])
        if text and text[-1] in units
        else int(text)
    )


def gib(n):
    return f"{n / (1 << 30):.1f} GiB"


class DigFailed(RuntimeError):
    """The product's dig did not finish; the disk says how it was left."""


def dig_through_product(c, poll=5.0, sleep=time.sleep):
    """Queue the product's dig_holes for one disk and wait until its task and the disk settle."""
    before = os.stat(c.path).st_blocks * 512
    task_id = api.dig_holes_storage(c.storage_id)
    while (api.poll_task(task_id) or {}).get("status") not in TERMINAL:
        sleep(poll)
    row = api.storage_row(c.storage_id)
    while row.get("status") == "maintenance":
        sleep(poll)
        row = api.storage_row(c.storage_id)
    status = (api.poll_task(task_id) or {}).get("status")
    if status != "finished":
        raise DigFailed(f"task {task_id} {status}; disk left {row.get('status')}")
    after = os.stat(c.path).st_blocks * 512
    return {
        "task_id": task_id,
        "path": c.path,
        "allocated_before": before,
        "allocated_after": after,
        "reclaimed": before - after,
    }


def main(argv=None):
    p = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    p.add_argument(
        "--apply", action="store_true", help="dig the holes (default: report only)"
    )
    p.add_argument("--ids", nargs="+", help="only these storage ids")
    p.add_argument("--min-reclaim", type=size, default=size("1g"))
    p.add_argument(
        "--limit", type=int, default=0, help="stop after N files (0: no limit)"
    )
    p.add_argument("--settle", type=int, default=DEFAULT_SETTLE_SECONDS)
    p.add_argument("--report", help="append one JSON line per file here")
    args = p.parse_args(argv)

    storages = api.fetch_storages_for_holes()
    domains = api.fetch_domains_for_holes()
    if args.ids:
        wanted = set(args.ids)
        storages_scope = [s for s in storages if s.get("id") in wanted]
    else:
        storages_scope = storages
    # Children are computed over every storage, not only the requested ones.
    candidates = classify(storages, domains, time.time(), args.settle)
    scope = {s["id"] for s in storages_scope}
    candidates = [c for c in candidates if c.storage_id in scope]

    eligible = []
    for c in candidates:
        if c.reason:
            continue
        try:
            measure(c)
        except FileNotFoundError:
            c.reason = "no file at its path"
            continue
        if c.reclaimable < args.min_reclaim:
            c.reason = f"reclaimable {gib(c.reclaimable)} below --min-reclaim"
            continue
        eligible.append(c)
    eligible.sort(key=lambda c: -c.reclaimable)

    skipped = {}
    for c in candidates:
        if c.reason:
            skipped[c.reason.split(" (")[0]] = (
                skipped.get(c.reason.split(" (")[0], 0) + 1
            )
    print(
        f"disks considered: {len(candidates)}; eligible: {len(eligible)}; "
        f"reclaimable: {gib(sum(c.reclaimable for c in eligible))}"
    )
    for reason, n in sorted(skipped.items(), key=lambda kv: -kv[1]):
        print(f"  skipped {n:5d}: {reason}")
    report = open(args.report, "a") if args.report else None
    done = 0
    for c in eligible:
        if args.limit and done >= args.limit:
            break
        line = f"{c.role:8s} {c.storage_id} allocated {gib(c.allocated)} data {gib(c.data or 0)} -> gives back ~{gib(c.reclaimable)}"
        if not args.apply:
            print("  would dig", line)
            if report:
                report.write(json.dumps({"dry_run": True, **as_report_row(c)}) + "\n")
            continue
        print("  digging", line, flush=True)
        try:
            record = dig_through_product(c)
        except api.StorageLockRefused as exc:
            print(f"  skip {c.storage_id}: apiv4 refused it ({exc})")
            continue
        except DigFailed as exc:
            damaged = "disk left damaged" in str(exc)
            print(f"{'STOP' if damaged else '  failed'} {c.storage_id}: {exc}", file=sys.stderr)
            if report:
                report.write(json.dumps({"error": "failed", "detail": str(exc)}) + "\n")
            if damaged:
                return 2
            continue
        record.update(storage_id=c.storage_id, role=c.role, ts=time.time())
        if report:
            report.write(json.dumps(record) + "\n")
            report.flush()
        print(f"    gave back {gib(record['reclaimed'])}")
        done += 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
