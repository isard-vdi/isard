        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "row",
      "title": "Desktops using the most disk",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "type": "table",
      "id": 13,
      "title": "Writing now (MB/s, 5 min)",
      "description": "Top 10 desktops by disk write rate over the last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "topk(10, sum by (desktop, category_id, user_id) (rate(isardvdi_domain_block_wr_bytes{domain=~\"$domain\"}[5m])) / 1048576)",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MB/s"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "MB/s",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "desktop": 0,
              "category_id": 1,
              "user_id": 2,
              "Value": 3
            },
            "renameByName": {
              "desktop": "Desktop",
              "category_id": "Category",
              "user_id": "User",
              "Value": "MB/s"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "id": 14,
      "title": "Writing sustained (MB/s, 24 h average)",
      "description": "Top 10 desktops by average write rate over 24 h. A desktop here is writing all day, not in a burst.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "topk(10, sum by (desktop, category_id, user_id) (rate(isardvdi_domain_block_wr_bytes{domain=~\"$domain\"}[24h])) / 1048576)",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
