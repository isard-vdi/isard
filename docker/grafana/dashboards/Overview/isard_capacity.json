        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Scheduled stops executed in the range",
      "description": "Desktops stopped by the scheduler: end of a booking or maximum time reached. Users see it as being kicked out.",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "expr": "sum(count_over_time({container_name=\"isard-scheduler\"} |= \"Actions.desktop_stop\" |= \"executed successfully\" |= \"\\\"level\\\"\" [$__range]))",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "stops",
          "queryType": "instant"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
