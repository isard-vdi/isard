    {
      "id": 6,
      "type": "stat",
      "title": "Metrics disk free",
      "description": "Free space where VictoriaMetrics keeps its data.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
