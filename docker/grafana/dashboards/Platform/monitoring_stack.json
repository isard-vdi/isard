{
  "annotations": {
    "list": []
  },
  "description": "Is the monitoring itself working: scrapes, delivery from every host, ingestion, alert evaluation and delivery.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "System Health",
      "type": "link",
      "url": "/d/system-health",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false,
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets down",
      "description": "Scrape targets that answered nothing on their last scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "count(up == 0) or on() (0 * count(up))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rules failing",
      "description": "vmalert rule groups with evaluation errors in the last 15m.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "count(sum by (group) (increase(vmalert_execution_errors_total[15m])) > 0) or on() (0 * max(isardvdi:vmalert_heartbeat))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
