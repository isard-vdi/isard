From: Josep Maria Viñolas Auquer <josepmaria@isardvdi.com>
Subject: [PATCH] RDP: invalidate the input queue once the RDP client thread ends

Only the RDP client thread dequeues input events, but nothing tells the user
threads when it stops. If the queue (GUAC_RDP_INPUT_EVENT_QUEUE_SIZE) is full
at that point, the user input thread blocks for ever in
guac_fifo_enqueue_and_lock(): it never sees the client stop, the user never
leaves and the connection process never exits.

Invalidate the queue when the client thread returns, on every path, so that
blocked and later enqueues fail at once, and stop
guac_rdp_input_event_enqueue() from signalling and unlocking a queue that
guac_fifo_enqueue_and_lock() has already released.
---
diff --git a/src/protocols/rdp/input-queue.c b/src/protocols/rdp/input-queue.c
index 1606d47..d00d7a5 100644
--- a/src/protocols/rdp/input-queue.c
+++ b/src/protocols/rdp/input-queue.c
@@ -244,7 +244,11 @@ complete:
 void guac_rdp_input_event_enqueue(guac_rdp_client* rdp_client,
         const guac_rdp_input_event* input_event) {
 
-    guac_fifo_enqueue_and_lock(&rdp_client->input_events, input_event);
+    /* The queue is invalidated once the RDP client thread has ended, and the
+     * fifo is then already unlocked: drop the event */
+    if (!guac_fifo_enqueue_and_lock(&rdp_client->input_events, input_event))
+        return;
+
     SetEvent(rdp_client->input_event_queued);
     guac_fifo_unlock(&rdp_client->input_events);
 
diff --git a/src/protocols/rdp/rdp.c b/src/protocols/rdp/rdp.c
index 4bba195..bc60cba 100644
--- a/src/protocols/rdp/rdp.c
+++ b/src/protocols/rdp/rdp.c
@@ -730,9 +730,15 @@ fail:
 
 }
 
-void* guac_rdp_client_thread(void* data) {
+/**
+ * The body of guac_rdp_client_thread(), returning once the RDP client will no
+ * longer service the connection, whether it ended normally or failed early.
+ *
+ * @param client
+ *     The guac_client associated with the RDP connection.
+ */
+static void guac_rdp_client_thread_run(guac_client* client) {
 
-    guac_client* client = (guac_client*) data;
     guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
     guac_rdp_settings* settings = rdp_client->settings;
 
@@ -752,7 +758,7 @@ void* guac_rdp_client_thread(void* data) {
             if (guac_itoa(str_port, settings->port) < 1) {
                 guac_client_log(client, GUAC_LOG_ERROR, "Failed to convert port to integer for WOL function.");
                 guac_mem_free(str_port);
-                return NULL;
+                return;
             }
 
             /* Send the Wake-on-LAN request and wait until the server is responsive. */
@@ -766,7 +772,7 @@ void* guac_rdp_client_thread(void* data) {
                     GUAC_WOL_DEFAULT_CONNECTION_TIMEOUT)) {
                 guac_client_log(client, GUAC_LOG_ERROR, "Failed to send WOL packet, or server failed to wake up.");
                 guac_mem_free(str_port);
-                return NULL;
+                return;
             }
 
             guac_mem_free(str_port);
@@ -778,7 +784,7 @@ void* guac_rdp_client_thread(void* data) {
                     settings->wol_broadcast_addr,
                     settings->wol_udp_port)) {
             guac_client_log(client, GUAC_LOG_ERROR, "Failed to send WOL packet.");
-            return NULL;
+            return;
         }
     }
     
@@ -821,7 +827,7 @@ void* guac_rdp_client_thread(void* data) {
             guac_client_abort(client, GUAC_PROTOCOL_STATUS_SERVER_ERROR,
                     "A username or SFTP-specific username is required if "
                     "SFTP is enabled.");
-            return NULL;
+            return;
         }
 
         guac_client_log(client, GUAC_LOG_DEBUG,
@@ -842,7 +848,7 @@ void* guac_rdp_client_thread(void* data) {
                         settings->sftp_passphrase)) {
                 guac_client_abort(client, GUAC_PROTOCOL_STATUS_SERVER_ERROR,
                         "Private key unreadable.");
-                return NULL;
+                return;
             }
 
             /* Import the public key, if that is specified. */
@@ -862,7 +868,7 @@ void* guac_rdp_client_thread(void* data) {
                             guac_common_ssh_key_error());
 
                     guac_common_ssh_destroy_user(rdp_client->sftp_user);
-                    return NULL;
+                    return;
 
                 }
 
@@ -894,7 +900,7 @@ void* guac_rdp_client_thread(void* data) {
         /* Fail if SSH connection does not succeed */
         if (rdp_client->sftp_session == NULL) {
             /* Already aborted within guac_common_ssh_create_session() */
-            return NULL;
+            return;
         }
 
         /* Load and expose filesystem */
@@ -913,7 +919,7 @@ void* guac_rdp_client_thread(void* data) {
         if (rdp_client->sftp_filesystem == NULL) {
             guac_client_abort(client, GUAC_PROTOCOL_STATUS_UPSTREAM_UNAVAILABLE,
                     "SFTP connection failed.");
-            return NULL;
+            return;
         }
 
         /* Configure destination for basic uploads, if specified */
@@ -947,6 +953,21 @@ void* guac_rdp_client_thread(void* data) {
             break;
     }
 
+}
+
+void* guac_rdp_client_thread(void* data) {
+
+    guac_client* client = (guac_client*) data;
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    guac_rdp_client_thread_run(client);
+
+    /* Nothing dequeues input events once this thread ends. Invalidate the
+     * queue so that a user thread blocked on a full queue (or enqueuing later)
+     * returns instead of waiting forever, which would keep the user from
+     * leaving and the connection process from ever exiting. */
+    guac_fifo_invalidate(&rdp_client->input_events);
+
     return NULL;
 
 }
