//
// TLS certificate served on this host's public name (copied by run.sh on hosts that serve it)
//
prometheus.exporter.blackbox "certificates" {
	config = "{ modules: { tls_connect: { prober: tcp, timeout: 10s, tcp: { tls: true, tls_config: { insecure_skip_verify: true } } } } }"

	target {
		name    = "public"
		address = sys.env("DOMAIN") + ":443"
		module  = "tls_connect"
	}
}

prometheus.scrape "certificates" {
	targets = prometheus.exporter.blackbox.certificates.targets

	forward_to      = [prometheus.relabel.certificates.receiver]
	job_name        = "certificates"
	scrape_interval = "5m"
}

// The exporter target names its own job; the rules select job="certificates".
prometheus.relabel "certificates" {
	forward_to = [prometheus.relabel.process_metrics_containers.receiver]

	rule {
		target_label = "job"
		replacement  = "certificates"
	}
}
