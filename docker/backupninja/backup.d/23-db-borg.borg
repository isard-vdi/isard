when = $BACKUP_DB_WHEN

[source]
## the borg handler unsets BORG_CACHE_DIR for a job without cache_directory
cache_directory = $BORG_CACHE_DIR
include = /dbdump

## for more info see : borg prune -h
keep = 0
prune = yes
prune_options = $BACKUP_DB_PRUNE

[dest]
directory = /backup/db
host = localhost
port = 22
user = root
archive = {now:%Y-%m-%dT%H:%M:%S}
compression = lz4
encryption = none
passphrase = 
