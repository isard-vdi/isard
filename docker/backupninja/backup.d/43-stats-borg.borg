when = $BACKUP_STATS_WHEN

[source]
## the borg handler unsets BORG_CACHE_DIR for a job without cache_directory
cache_directory = $BORG_CACHE_DIR
include = /opt/isard/stats/loki
include = /opt/isard/stats/victoriametrics-backup

## for more info see : borg prune -h
keep = 0
prune = yes
prune_options = $BACKUP_STATS_PRUNE

[dest]
directory = /backup/stats
host = localhost
port = 22
user = root
archive = {now:%Y-%m-%dT%H:%M:%S}
compression = lz4
encryption = none
passphrase = 
